# Production Environment Variables для VK Cloud
# Скопируйте этот файл в .env.production и заполните значения

# ========================================
# Database (Managed PostgreSQL от VK Cloud)
# ========================================
# Получите эти данные из панели VK Cloud после создания managed PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@your-postgres-host.vkcloud.ru:5432/ai_hr_db
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=ai_hr_db

# ========================================
# AI Services
# ========================================
# DeepSeek API Key - получите на https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key

# Google Cloud credentials - путь к файлу или JSON строка
# Для production лучше использовать файл gcp-credentials.json в корне проекта
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# ========================================
# Text-to-Speech Settings (Google Cloud)
# ========================================
TTS_VOICE_NAME=ru-RU-Chirp3-HD-Orus
TTS_LANGUAGE_CODE=ru-RU
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0

# ========================================
# Security
# ========================================
# ВАЖНО: Сгенерируйте новый секретный ключ!
# Используйте: openssl rand -hex 32
SECRET_KEY=your_production_secret_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# CORS Origins
# ========================================
# Замените на ваш реальный домен
CORS_ORIGINS=https://yourdomain.ru,https://www.yourdomain.ru

# ========================================
# Audio Storage
# ========================================
AUDIO_STORAGE_PATH=/app/audio_files
MAX_AUDIO_SIZE_MB=50

# ========================================
# Analyzers Configuration
# ========================================
# Какие анализаторы включены (через запятую)
ENABLED_ANALYZERS=gpt_content_analyzer,clarity_analyzer

# Веса для разных метрик (должны в сумме давать 1.0)
PRONUNCIATION_WEIGHT=0.2
CLARITY_WEIGHT=0.15
GPT_CONTENT_WEIGHT=0.5
STRESS_HANDLING_WEIGHT=0.15

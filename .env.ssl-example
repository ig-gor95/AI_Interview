# Обновите эти переменные в вашем .env файле после установки SSL

# CORS - добавьте HTTPS домены
CORS_ORIGINS=https://screenme.pro,https://www.screenme.pro

# Если у вас есть другие переменные связанные с доменом, обновите их тоже:
# FRONTEND_URL=https://screenme.pro
# BACKEND_URL=https://screenme.pro/api

# После обновления .env перезапустите backend:
# docker-compose -f docker-compose.timeweb.yml restart backend

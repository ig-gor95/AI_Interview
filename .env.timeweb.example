# Environment Variables для Timeweb Cloud
# Скопируйте этот файл в .env и заполните значения

# ========================================
# Database (PostgreSQL в Docker контейнере)
# ========================================
POSTGRES_USER=aihr_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_NOW
POSTGRES_DB=ai_hr_db

# ========================================
# AI Services
# ========================================
# DeepSeek API Key - получите на https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Google Cloud credentials - путь к файлу
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# ========================================
# Text-to-Speech Settings (Google Cloud)
# ========================================
TTS_VOICE_NAME=ru-RU-Chirp3-HD-Orus
TTS_LANGUAGE_CODE=ru-RU
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0

# ========================================
# Security
# ========================================
# ВАЖНО: Сгенерируйте новый секретный ключ!
# Используйте: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_SECRET_KEY_GENERATE_NEW_ONE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# CORS Origins
# ========================================
# Замените на ваш реальный IP или домен
# Формат: http://IP1,http://IP2,https://domain.com
CORS_ORIGINS=http://YOUR_SERVER_IP,https://yourdomain.ru

# ========================================
# Audio Storage
# ========================================
AUDIO_STORAGE_PATH=/app/audio_files
MAX_AUDIO_SIZE_MB=50

# ========================================
# Analyzers Configuration
# ========================================
# Какие анализаторы включены (через запятую)
ENABLED_ANALYZERS=gpt_content_analyzer,clarity_analyzer

# Веса для разных метрик (должны в сумме давать 1.0)
PRONUNCIATION_WEIGHT=0.2
CLARITY_WEIGHT=0.15
GPT_CONTENT_WEIGHT=0.5
STRESS_HANDLING_WEIGHT=0.15
